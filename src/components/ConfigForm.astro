---
---
<form role="form" aria-label="Database Configuration Settings" class="mt-4">

  <!-- Database Software + Version -->
  <div class="mb-5">
    <label for="dbSoftware" class="block text-sm font-semibold text-zinc-700 mb-1.5">
      Database Software
    </label>
    <select
      id="dbSoftware"
      class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      aria-describedby="dbSoftware-help"
    >
      <optgroup label="MySQL">
        <option value="mysql-8.0">MySQL 8.0</option>
        <option value="mysql-8.4">MySQL 8.4 LTS</option>
      </optgroup>
      <optgroup label="MariaDB">
        <option value="mariadb-10.6">MariaDB 10.6</option>
        <option value="mariadb-10.11">MariaDB 10.11 LTS</option>
        <option value="mariadb-11.4">MariaDB 11.4 LTS</option>
      </optgroup>
    </select>
    <p id="dbSoftware-help" class="mt-1 text-xs text-zinc-500">
      Settings differ between MySQL and MariaDB versions — each version generates the correct config.
    </p>
  </div>

  <!-- Workload Template -->
  <div class="mb-5">
    <label for="workloadTemplate" class="block text-sm font-semibold text-zinc-700 mb-1.5">
      Workload Template
    </label>
    <select
      id="workloadTemplate"
      class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      aria-describedby="workloadTemplate-help"
    >
      <option value="custom">Custom Configuration</option>
      <option value="oltp">OLTP (Online Transaction Processing)</option>
      <option value="olap">OLAP (Online Analytical Processing)</option>
      <option value="mixed">Mixed Workload</option>
      <option value="webserver">Web Server</option>
      <option value="smallserver">Small VPS Server</option>
    </select>
    <p id="workloadTemplate-help" class="mt-1 text-xs text-zinc-500">
      Select a predefined template or customize your own settings.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-2">

    <!-- Total Server Memory -->
    <div class="flex flex-col gap-1.5">
      <label for="totalMemory" class="text-sm font-semibold text-zinc-700">
        Total Memory (GB)
        <span class="text-red-500 ml-0.5" aria-label="Required">*</span>
      </label>
      <input
        type="range"
        id="totalMemorySlider"
        min="1" max="512" step="0.5" value="16"
        class="w-full accent-blue-600 cursor-pointer"
        aria-label="Total Server Memory slider"
        aria-describedby="totalMemory-help"
      />
      <input
        type="number"
        id="totalMemory"
        value="16" min="1" max="512" step="0.1"
        class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
        placeholder="e.g. 16"
        aria-describedby="totalMemory-help"
        required
      />
      <p id="totalMemory-help" class="text-xs text-zinc-500">Total RAM on your server (up to 512 GB)</p>
    </div>

    <!-- Reserved Memory for OS -->
    <div class="flex flex-col gap-1.5">
      <label for="reservedMemory" class="text-sm font-semibold text-zinc-700">
        Reserved for OS (GB)
      </label>
      <input
        type="range"
        id="reservedMemorySlider"
        min="0" max="256" step="0.1" value="0"
        class="w-full accent-blue-600 cursor-pointer"
        aria-label="Reserved Memory slider"
        aria-describedby="reservedMemory-help"
      />
      <input
        type="number"
        id="reservedMemory"
        value="0" min="0" max="256" step="0.1"
        class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
        placeholder="e.g. 2"
        aria-describedby="reservedMemory-help"
      />
      <p id="reservedMemory-help" class="text-xs text-zinc-500">Memory reserved for the OS and essential services</p>
    </div>

    <!-- Memory for Other Tasks -->
    <div class="flex flex-col gap-1.5">
      <label for="otherTasksMemory" class="text-sm font-semibold text-zinc-700">
        Other Tasks (GB)
      </label>
      <input
        type="range"
        id="otherTasksMemorySlider"
        min="0" max="256" step="0.5" value="0"
        class="w-full accent-blue-600 cursor-pointer"
        aria-label="Other Tasks Memory slider"
        aria-describedby="otherTasksMemory-help"
      />
      <input
        type="number"
        id="otherTasksMemory"
        value="0" min="0" max="256" step="0.1"
        class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
        placeholder="e.g. 1"
        aria-describedby="otherTasksMemory-help"
      />
      <p id="otherTasksMemory-help" class="text-xs text-zinc-500">For web servers, apps, or other services</p>
    </div>

    <!-- OS + Storage in a nested 2-col on larger, stacked on small -->
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-1.5">
        <label for="osType" class="text-sm font-semibold text-zinc-700">Operating System</label>
        <select
          id="osType"
          class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
          aria-describedby="osType-help"
        >
          <option value="linux">Linux</option>
          <option value="windows">Windows</option>
          <option value="macos">macOS</option>
        </select>
        <p id="osType-help" class="text-xs text-zinc-500">Affects InnoDB flush method</p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="storageType" class="text-sm font-semibold text-zinc-700">Storage Type</label>
        <select
          id="storageType"
          class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
          aria-describedby="storageType-help"
        >
          <option value="ssd">SSD (Default)</option>
          <option value="nvme">NVMe</option>
          <option value="hdd">HDD (Traditional)</option>
        </select>
        <p id="storageType-help" class="text-xs text-zinc-500">Affects I/O capacity and optimizations</p>
      </div>
    </div>

  </div>
</form>
