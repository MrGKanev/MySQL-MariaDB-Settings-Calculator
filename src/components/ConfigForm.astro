---
---
<form role="form" aria-label="MySQL Configuration Settings">
  <!-- Workload Template -->
  <div class="mt-6 mb-4">
    <label for="workloadTemplate" class="block text-sm font-medium text-zinc-700 mb-1">
      Workload Template
    </label>
    <select
      id="workloadTemplate"
      class="block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
      aria-describedby="workloadTemplate-help"
    >
      <option value="custom">Custom Configuration</option>
      <option value="oltp">OLTP (Online Transaction Processing)</option>
      <option value="olap">OLAP (Online Analytical Processing)</option>
      <option value="mixed">Mixed Workload</option>
      <option value="webserver">Web Server</option>
      <option value="smallserver">Small VPS Server</option>
    </select>
    <p id="workloadTemplate-help" class="mt-1 text-sm text-zinc-600">
      Select a predefined template or customize your own settings.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <!-- Total Server Memory -->
    <div>
      <label for="totalMemory" class="block text-sm font-medium text-zinc-700 mb-1">
        Total Server Memory (GB)
        <span class="text-red-500" aria-label="Required">*</span>
      </label>
      <input
        type="range"
        id="totalMemorySlider"
        min="1" max="512" step="0.5" value="16"
        class="w-full mb-2 focus:outline-none focus:ring-2 focus:ring-blue-300"
        aria-label="Total Server Memory slider"
        aria-describedby="totalMemory-help"
      />
      <input
        type="number"
        id="totalMemory"
        value="16" min="0.5" max="512" step="0.1"
        class="mt-1 block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
        placeholder="Enter total memory in GB"
        aria-describedby="totalMemory-help"
        required
      />
      <p id="totalMemory-help" class="mt-1 text-sm text-zinc-600">
        Total RAM available on your server (supports up to 512GB)
      </p>
    </div>

    <!-- Reserved Memory for OS -->
    <div>
      <label for="reservedMemory" class="block text-sm font-medium text-zinc-700 mb-1">
        Reserved Memory for OS (GB)
      </label>
      <input
        type="range"
        id="reservedMemorySlider"
        min="0" max="256" step="0.1" value="0"
        class="w-full mb-2 focus:outline-none focus:ring-2 focus:ring-blue-300"
        aria-label="Reserved Memory slider"
        aria-describedby="reservedMemory-help"
      />
      <input
        type="number"
        id="reservedMemory"
        value="0" min="0" max="256" step="0.1"
        class="mt-1 block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
        placeholder="Enter reserved memory"
        aria-describedby="reservedMemory-help"
      />
      <p id="reservedMemory-help" class="mt-1 text-sm text-zinc-600">
        Memory to reserve for the operating system and essential services
      </p>
    </div>

    <!-- Memory for Other Tasks -->
    <div>
      <label for="otherTasksMemory" class="block text-sm font-medium text-zinc-700 mb-1">
        Memory for Other Tasks (GB)
      </label>
      <input
        type="range"
        id="otherTasksMemorySlider"
        min="0" max="256" step="0.5" value="0"
        class="w-full mb-2 focus:outline-none focus:ring-2 focus:ring-blue-300"
        aria-label="Other Tasks Memory slider"
        aria-describedby="otherTasksMemory-help"
      />
      <input
        type="number"
        id="otherTasksMemory"
        value="0" min="0" max="256" step="0.1"
        class="mt-1 block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
        placeholder="Enter memory for other tasks"
        aria-describedby="otherTasksMemory-help"
      />
      <p id="otherTasksMemory-help" class="mt-1 text-sm text-zinc-600">
        Memory allocated for web servers, applications, or other services (up to 256GB)
      </p>
    </div>

    <!-- Operating System -->
    <div>
      <label for="osType" class="block text-sm font-medium text-zinc-700 mb-1">
        Operating System
      </label>
      <select
        id="osType"
        class="mt-1 block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
        aria-describedby="osType-help"
      >
        <option value="linux">Linux</option>
        <option value="windows">Windows</option>
        <option value="macos">macOS</option>
      </select>
      <p id="osType-help" class="mt-1 text-sm text-zinc-600">
        Affects optimal InnoDB flush method settings
      </p>
    </div>

    <!-- Storage Type -->
    <div>
      <label for="storageType" class="block text-sm font-medium text-zinc-700 mb-1">
        Storage Type
      </label>
      <select
        id="storageType"
        class="mt-1 block w-full rounded-md border-zinc-300 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
        aria-describedby="storageType-help"
      >
        <option value="ssd">SSD (Default)</option>
        <option value="nvme">NVMe</option>
        <option value="hdd">HDD (Traditional)</option>
      </select>
      <p id="storageType-help" class="mt-1 text-sm text-zinc-600">
        Affects InnoDB I/O optimizations and flush neighbors setting
      </p>
    </div>
  </div>
</form>
