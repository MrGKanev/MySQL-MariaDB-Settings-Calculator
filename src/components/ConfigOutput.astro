---
---
<section aria-label="Generated Configuration">
  <div
    id="configOutput"
    class="mt-4 bg-zinc-800 text-zinc-200 p-4 rounded-md font-mono text-sm overflow-x-auto hidden"
    role="region"
    aria-label="Generated configuration"
  >
    <div class="flex justify-between items-center mb-2">
      <span class="text-xs text-zinc-400">Generated Configuration</span>
      <button
        type="button"
        id="configCopyBtn"
        class="text-xs text-zinc-300 hover:text-white focus:text-white focus:outline-none focus:ring-1 focus:ring-blue-300 rounded px-2 py-1"
        aria-label="Copy configuration to clipboard"
      >
        Copy
      </button>
    </div>
    <pre id="configContent" tabindex="0" role="textbox" aria-readonly="true" aria-label="Configuration content"></pre>
  </div>
</section>
