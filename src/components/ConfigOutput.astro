---
---
<section aria-label="Generated Configuration">
  <div
    id="configOutput"
    class="mt-4 bg-zinc-900 text-zinc-100 p-4 rounded-xl font-mono text-sm overflow-x-auto hidden border border-zinc-700"
    role="region"
    aria-label="Generated configuration"
  >
    <div class="flex justify-between items-center mb-3 pb-2 border-b border-zinc-700">
      <span class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Generated Configuration</span>
      <button
        type="button"
        id="configCopyBtn"
        class="text-xs text-zinc-400 hover:text-white focus:text-white focus:outline-none focus:ring-1 focus:ring-blue-400 rounded px-2 py-1 transition-colors"
        aria-label="Copy configuration to clipboard"
      >
        Copy
      </button>
    </div>
    <pre id="configContent" tabindex="0" role="textbox" aria-readonly="true" aria-label="Configuration content" class="leading-relaxed"></pre>
  </div>
</section>
