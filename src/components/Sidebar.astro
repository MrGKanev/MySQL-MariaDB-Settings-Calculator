---
---
<aside class="w-full md:w-1/3 px-3">
  <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
    <h2 class="text-2xl font-bold mb-4 text-blue-600">Useful Links</h2>
    <div id="sidebarContent">
      <section class="mb-4">
        <h3 class="text-lg font-semibold mb-2">MySQL Tutorials</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <a href="https://dev.mysql.com/doc/refman/8.0/en/tutorial.html"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">MySQL Official Tutorial</a>
          </li>
          <li>
            <a href="https://www.w3schools.com/mysql/"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">W3Schools MySQL Tutorial</a>
          </li>
        </ul>
      </section>

      <section class="mb-4">
        <h3 class="text-lg font-semibold mb-2">MariaDB Tutorials</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <a href="https://mariadb.com/kb/en/training-tutorials/"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">MariaDB Tutorials</a>
          </li>
          <li>
            <a href="https://www.tutorialspoint.com/mariadb/"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">TutorialsPoint MariaDB Tutorial</a>
          </li>
        </ul>
      </section>

      <section>
        <h3 class="text-lg font-semibold mb-2">Documentation</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <a href="https://dev.mysql.com/doc/"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">MySQL Documentation</a>
          </li>
          <li>
            <a href="https://mariadb.com/kb/en/documentation/"
               class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
               target="_blank" rel="noopener">MariaDB Documentation</a>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <footer class="bg-white rounded-xl shadow-lg p-8">
    <div class="flex justify-between items-center">
      <div class="text-sm text-zinc-500">
        &copy; <span id="currentYear"></span> Created by
        <a href="https://gkanev.com"
           class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
           target="_blank" rel="noopener">Gabriel Kanev</a>
      </div>
      <div class="text-sm text-zinc-500">
        <a href="https://github.com/MrGKanev/MySQL-MariaDB-Settings-Calculator"
           class="text-blue-500 hover:underline focus:underline focus:outline-none focus:ring-2 focus:ring-blue-300 rounded"
           target="_blank" rel="noopener">You can help at GitHub</a>
      </div>
    </div>
    <div class="mt-2 text-xs text-zinc-400 text-center">
      <span id="appVersion">3.0.0</span>
    </div>
  </footer>
</aside>
