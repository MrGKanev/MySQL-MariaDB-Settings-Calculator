---
interface Props {
  dbType: 'mysql' | 'postgresql';
}
const { dbType } = Astro.props;
const isMysql = dbType === 'mysql';
---
<header class="mb-6">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-2">
    <h1 id="pageTitle" class="text-3xl font-bold text-blue-600">
      {isMysql ? 'MySQL/MariaDB Settings Calculator' : 'PostgreSQL Settings Calculator'}
    </h1>
    <nav class="flex items-center bg-zinc-200 rounded-full p-1" role="navigation" aria-label="Database type selector">
      <a
        href="/"
        class={`px-4 py-1.5 rounded-full text-sm font-medium transition-colors ${isMysql ? 'bg-blue-600 text-white' : 'text-zinc-600 hover:text-zinc-900'}`}
        aria-current={isMysql ? 'page' : undefined}
      >
        MySQL
      </a>
      <a
        href="/postgresql"
        class={`px-4 py-1.5 rounded-full text-sm font-medium transition-colors ${!isMysql ? 'bg-blue-600 text-white' : 'text-zinc-600 hover:text-zinc-900'}`}
        aria-current={!isMysql ? 'page' : undefined}
      >
        PostgreSQL
      </a>
    </nav>
  </div>
  <p id="pageDescription" class="text-center text-zinc-600 mb-4">
    {isMysql
      ? 'Generate optimized MySQL/MariaDB configurations based on your server specifications'
      : 'Generate optimized PostgreSQL configurations based on your server specifications'}
  </p>
  <div class="flex justify-center gap-4 text-sm">
    <button
      type="button"
      id="helpButton"
      data-help
      class="text-blue-600 underline hover:text-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300 rounded px-2 py-1"
      aria-label="Open help and keyboard shortcuts"
    >
      Help (F1)
    </button>
    <button
      type="button"
      id="shareButton"
      class="text-blue-600 underline hover:text-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300 rounded px-2 py-1"
      aria-label="Share current configuration"
    >
      Share Config
    </button>
    <button
      type="button"
      id="resetButton"
      class="text-blue-600 underline hover:text-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300 rounded px-2 py-1"
      aria-label="Reset form to default values"
    >
      Reset
    </button>
  </div>
</header>
