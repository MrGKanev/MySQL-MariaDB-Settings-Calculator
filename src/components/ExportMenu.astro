---
interface Props {
  dbType?: 'mysql' | 'postgresql';
}

const { dbType = 'mysql' } = Astro.props;
const isPostgres = dbType === 'postgresql';
const configFormat = isPostgres ? 'postgresql.conf' : 'my.cnf';
---
<div class="mt-6 flex flex-wrap gap-2 sm:gap-3">
  <button
    id="generateConfigBtn"
    type="button"
    class="flex-1 sm:flex-none bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-medium py-2.5 px-5 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 text-sm"
    aria-describedby="generateConfig-help"
  >
    Generate {configFormat} File
  </button>
  <p id="generateConfig-help" class="sr-only">Generate configuration file based on current settings</p>

  <div class="relative" id="exportDropdown">
    <button
      id="exportOptionsBtn"
      type="button"
      class="flex items-center gap-1.5 bg-zinc-700 hover:bg-zinc-800 active:bg-zinc-900 text-white font-medium py-2.5 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400 focus:ring-offset-2 text-sm hidden"
      aria-expanded="false"
      aria-haspopup="true"
    >
      Export
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </button>
    <div
      id="exportMenu"
      class="hidden absolute left-0 mt-1.5 w-52 bg-white rounded-xl shadow-lg border border-zinc-200 z-10 overflow-hidden"
      role="menu"
    >
      <button
        type="button"
        id="exportConfigBtn"
        class="export-option w-full text-left px-4 py-2.5 text-sm text-zinc-700 hover:bg-zinc-50 focus:bg-zinc-50 focus:outline-none"
        data-format={configFormat}
        role="menuitem"
      >
        Download {configFormat}
      </button>
      <button
        type="button"
        class="export-option w-full text-left px-4 py-2.5 text-sm text-zinc-700 hover:bg-zinc-50 focus:bg-zinc-50 focus:outline-none"
        data-format="json"
        role="menuitem"
      >
        Download JSON
      </button>
      <button
        type="button"
        id="exportPgHbaBtn"
        class={`export-option w-full text-left px-4 py-2.5 text-sm text-zinc-700 hover:bg-zinc-50 focus:bg-zinc-50 focus:outline-none ${isPostgres ? '' : 'hidden'}`}
        data-format="pg_hba.conf"
        role="menuitem"
      >
        Download pg_hba.conf
      </button>
      <button
        type="button"
        class="export-option w-full text-left px-4 py-2.5 text-sm text-zinc-700 hover:bg-zinc-50 focus:bg-zinc-50 focus:outline-none"
        data-format="docker-compose"
        role="menuitem"
      >
        Download Docker Compose
      </button>
      <div class="border-t border-zinc-100">
        <button
          type="button"
          class="export-option w-full text-left px-4 py-2.5 text-sm text-zinc-700 hover:bg-zinc-50 focus:bg-zinc-50 focus:outline-none"
          data-action="copy"
          role="menuitem"
        >
          Copy to Clipboard
        </button>
      </div>
    </div>
  </div>

  <button
    id="copyConfigBtn"
    type="button"
    class="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-medium py-2.5 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 text-sm hidden"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
      <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"/><path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"/>
    </svg>
    Copy
  </button>

  <button
    id="downloadConfigBtn"
    type="button"
    class="flex items-center gap-1.5 bg-violet-600 hover:bg-violet-700 active:bg-violet-800 text-white font-medium py-2.5 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 text-sm hidden"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
    </svg>
    Download
  </button>
</div>
