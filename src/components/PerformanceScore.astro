---
---
<div class="bg-white rounded-xl shadow-lg p-8 mb-8">
  <h2 class="text-2xl font-bold mb-4 text-blue-600">Performance Score</h2>

  <div id="performanceScore" class="flex items-center justify-center mb-4" role="img" aria-label="Performance score visualization">
    <div class="relative w-40 h-40">
      <svg viewBox="0 0 100 100" class="w-full h-full transform -rotate-90" role="img" aria-hidden="true">
        <circle cx="50" cy="50" r="42" fill="none" stroke="#f1f5f9" stroke-width="6" />
        <circle
          id="scoreCircle"
          cx="50" cy="50" r="42"
          fill="none"
          stroke="#3b82f6"
          stroke-width="6"
          stroke-dasharray="264"
          stroke-dashoffset="264"
          stroke-linecap="round"
          style="transition: stroke-dashoffset 1s ease-in-out, stroke 0.3s ease;"
        />
      </svg>
      <div class="absolute inset-0 flex items-center justify-center flex-col">
        <span id="scoreValue" class="text-3xl font-bold text-blue-600" aria-live="polite">0</span>
        <div class="text-sm text-zinc-600 mt-1 text-center leading-tight">
          <div>Performance</div>
          <div>Score</div>
        </div>
        <div class="mt-1">
          <span id="scoreGrade" class="text-xs font-medium px-2 py-1 rounded-full bg-zinc-100 text-zinc-600">N/A</span>
        </div>
      </div>
    </div>
  </div>

  <div id="scoreBreakdown" class="grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="Score breakdown by category">
    <!-- Populated by JavaScript -->
  </div>

  <div id="scoreRecommendations" class="mt-4 border-t border-zinc-200 pt-4">
    <h3 class="text-lg font-semibold mb-2">Recommendations</h3>
    <ul class="list-disc pl-5 space-y-2" role="list">
      <!-- Populated by JavaScript -->
    </ul>
  </div>
</div>
