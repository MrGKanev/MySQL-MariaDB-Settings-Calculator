---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ConfigForm from '../components/ConfigForm.astro';
import ExportMenu from '../components/ExportMenu.astro';
import ConfigOutput from '../components/ConfigOutput.astro';
import PerformanceScore from '../components/PerformanceScore.astro';
import FaqSection from '../components/FaqSection.astro';
import Sidebar from '../components/Sidebar.astro';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import '../styles/global.css';
---

<Layout
  title="PostgreSQL Settings Calculator - Generate Optimized postgresql.conf | Gabriel Kanev"
  description="Free tool to generate optimized PostgreSQL configurations based on your server memory. Calculate shared_buffers, work_mem, effective_cache_size, and more. Export postgresql.conf instantly."
  canonical="https://database.gkanev.com/postgresql"
  dbType="postgresql"
>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 bg-blue-600 text-white p-2 rounded z-50">
    Skip to main content
  </a>

  <div class="container mx-auto px-3 sm:px-4">
    <div class="flex flex-wrap lg:-mx-3">

      <div class="w-full lg:w-2/3 lg:px-3">
        <main id="main-content">

          <div class="bg-white rounded-xl shadow-sm border border-zinc-200 p-4 sm:p-6 lg:p-8 mb-5">
            <Header dbType="postgresql" />
            <ConfigForm dbType="postgresql" />

            <div id="error" class="text-red-700 mb-4 hidden p-3 bg-red-50 rounded-lg border border-red-200 text-sm" role="alert" aria-live="polite"></div>

            <section aria-label="Calculation Results">
              <div id="results" class="mt-5 bg-zinc-50 rounded-lg p-4 border border-zinc-100" aria-live="polite">
                <p class="text-zinc-500 text-sm text-center py-2">Enter your server specifications above to see recommendations.</p>
              </div>
            </section>

            <ExportMenu dbType="postgresql" />
            <ConfigOutput />
          </div>

          <PerformanceScore />
          <FaqSection dbType="postgresql" />

        </main>
      </div>

      <Sidebar dbType="postgresql" />

    </div>
  </div>

  <LoadingIndicator />

  <script>
    import '../scripts/main.js';
  </script>
</Layout>
